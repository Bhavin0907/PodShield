[Unit]
Description=PodShield scheduled scan of all local images
Requires=podman.socket
After=network.target podman.socket

[Service]
Type=oneshot
Environment=PODSHIELD_CONFIG=/etc/podshield/config.toml
EnvironmentFile=-/etc/podshield/podshield.env
# Exit code is 0 unless the scan itself fails. Add `--fail-on high` to make the unit "failed"
# (visible in `systemctl --failed`) when any image has a high or critical issue.
ExecStart=/opt/podshield/venv/bin/podshield scan --all
User=root
UMask=0077
# Light hardening. Root is still required (rootful Podman socket, `podman image mount`,
# oscap-podman), so this only hides /home and /root (empty tmpfs), gives a private /tmp, and
# forbids gaining privileges through setuid binaries. If the SELinux policy cannot handle
# NoNewPrivileges for podman, install.sh adds a drop-in (podshield-*.service.d/) that turns it off.
PrivateTmp=true
ProtectHome=tmpfs
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
# Many images with oscap/trivy can take a while.
TimeoutStartSec=4h
# Logs go to journald: journalctl -u podshield-scan
StandardOutput=journal
StandardError=journal
SyslogIdentifier=podshield-scan
