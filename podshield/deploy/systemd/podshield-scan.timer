[Unit]
Description=Daily PodShield scan of all local images

[Timer]
# Every day at 02:30 (host time).
OnCalendar=*-*-* 02:30:00
# Spread the start a little so it does not collide with other nightly jobs.
RandomizedDelaySec=10min
# If the VM was off at 02:30, scan shortly after it boots.
Persistent=true
Unit=podshield-scan.service

[Install]
WantedBy=timers.target
