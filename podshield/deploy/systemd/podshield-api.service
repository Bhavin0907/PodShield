[Unit]
Description=PodShield API and dashboard
# The rootful Podman API socket is socket-activated: Requires= makes systemd start it first
# and stop this service if it is stopped.
Requires=podman.socket
After=network.target podman.socket

[Service]
Type=simple
# Defaults; the installer writes the real values to /etc/podshield/podshield.env (below).
# PODSHIELD_HOST=127.0.0.1 keeps the dashboard off the network. There is no login, so only
# change it behind something that authenticates users.
Environment=PODSHIELD_CONFIG=/etc/podshield/config.toml
Environment=PODSHIELD_STATIC_DIR=/opt/podshield/frontend/dist
Environment=PODSHIELD_HOST=127.0.0.1
Environment=PODSHIELD_PORT=8080
EnvironmentFile=-/etc/podshield/podshield.env
# Exactly one worker: scan progress (SSE) and the scan queue live in this process's memory.
ExecStart=/opt/podshield/venv/bin/uvicorn --factory podshield.main:create_default_app \
    --host ${PODSHIELD_HOST} --port ${PODSHIELD_PORT} --workers 1 --no-server-header
Restart=on-failure
RestartSec=3
# Root is needed for the rootful Podman socket and for `podman image mount`.
User=root
UMask=0077
# Light hardening. Root is still required (rootful Podman socket, `podman image mount`,
# oscap-podman), so this only hides /home and /root (empty tmpfs), gives a private /tmp, and
# forbids gaining privileges through setuid binaries. If the SELinux policy cannot handle
# NoNewPrivileges for podman, install.sh adds a drop-in (podshield-*.service.d/) that turns it off.
PrivateTmp=true
ProtectHome=tmpfs
NoNewPrivileges=true
# Stopping while a scan runs: the scan is marked failed on the next start.
TimeoutStopSec=30
# Logs go to journald: journalctl -u podshield-api
StandardOutput=journal
StandardError=journal
SyslogIdentifier=podshield-api

[Install]
WantedBy=multi-user.target
